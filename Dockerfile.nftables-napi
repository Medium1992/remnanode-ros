# Builds the RouterOS-compatible nftables-napi binaries for remnanode-ros.
#
# Upstream's build script cross-compiles with zig, so a single amd64 build
# produces both architectures and no QEMU is involved. The output is a scratch
# image holding just the prebuilds and the version they were built from.
FROM node:24-trixie-slim AS build

ARG NFTABLES_NAPI_VERSION

RUN test -n "${NFTABLES_NAPI_VERSION}"

# binutils supplies the `ld` that libmnl/libnftnl's configure looks for; the
# rest is the toolchain zig and the netfilter tarballs need.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils bzip2 ca-certificates git make xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/nftables-napi

COPY patches/ /patches/

RUN git clone --depth 1 --branch "${NFTABLES_NAPI_VERSION}" \
        https://github.com/kastov/nftables-napi.git . \
    && git apply --3way "/patches/routeros-${NFTABLES_NAPI_VERSION}.patch" \
    && npm ci --no-audit --no-fund \
    && node scripts/build.mjs linux-x64-glibc linux-arm64-glibc

RUN mkdir -p /out \
    && cp -r prebuilds/linux-x64 prebuilds/linux-arm64 /out/ \
    && printf '%s' "${NFTABLES_NAPI_VERSION}" > /out/VERSION \
    && test -s /out/linux-x64/nftables-napi.glibc.node \
    && test -s /out/linux-arm64/nftables-napi.glibc.node

FROM scratch

COPY --from=build /out/ /
