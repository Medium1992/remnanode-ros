+
+// Two of the things createTable() asks for are newer than the rest and are not
+// available on every kernel that otherwise speaks nftables:
+//
+//   NFT_SET_EXPR    the per-element counter on every set, Linux >= 5.7
+//   NFT_SET_CONCAT  the flag announcing the concatenated key of a port set
+//
+// Both are optional and both are refused with EINVAL. A concatenated set is
+// still described by NFTA_SET_DESC_CONCAT, which such kernels do understand, so
+// only the flag has to go; and dropping the per-element expression leaves the
+// named counter objects — which are old and widely supported — still accounting
+// blocked traffic per set.
+//
+// The ladder therefore gives up as little as possible at each step, and only
+// after the kernel has refused the step before. A kernel that lacks nothing but
+// NFT_SET_EXPR keeps its per-set numbers and loses only the per-element
+// breakdown; giving up counters entirely is the last resort. `counters: false`
+// starts at that end, as asked.
+//
+// On a kernel that supports both features the first attempt succeeds and
+// nothing else runs.
+NlResult CreateTableOp::execute(NlSocket& sock) {
+    struct Attempt {
+        bool concat_flag;
+        CounterMode counters;
+        const char* given_up;  // nullptr for the attempt that gives up nothing
+    };
+
+    static constexpr Attempt full[] = {
+        {true, CounterMode::Full, nullptr},
+        {false, CounterMode::Full, "the NFT_SET_CONCAT flag"},
+        {true, CounterMode::NamedOnly, "per-element counters"},
+        {false, CounterMode::NamedOnly, "per-element counters and the NFT_SET_CONCAT flag"},
+        {true, CounterMode::None, "all counters"},
+        {false, CounterMode::None, "all counters and the NFT_SET_CONCAT flag"},
+    };
+    // A caller that asked for no counters has nothing to give up on that axis.
+    static constexpr Attempt without_counters[] = {
+        {true, CounterMode::None, nullptr},
+        {false, CounterMode::None, "the NFT_SET_CONCAT flag"},
+    };
+
+    const Attempt* attempts = cfg_->counters ? full : without_counters;
+    const size_t count = cfg_->counters ? std::size(full) : std::size(without_counters);
+
+    NlResult first{false, "no attempt made", 0};
+    for (size_t i = 0; i < count; ++i) {
+        NlResult res = create_once(sock, attempts[i].concat_flag, attempts[i].counters);
+        if (res.success) {
+            if (attempts[i].given_up) {
+                // A silent downgrade would leave someone hunting for counters
+                // that are never going to appear, so say it once.
+                std::fprintf(stderr,
+                             "nftables-napi: this kernel refused part of the table; "
+                             "created it without %s\n",
+                             attempts[i].given_up);
+            }
+            return res;
+        }
+        if (i == 0) first = res;
+        // Only EINVAL means "this kernel does not know that". Anything else is
+        // a real failure, and retrying with fewer features would just hide it.
+        if (res.error_code != EINVAL) break;
+    }
+    return first;
+}
