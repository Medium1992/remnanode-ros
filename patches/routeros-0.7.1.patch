@@ -4,12 +4,27 @@
 #include "nft_config.h"
 #include <memory>
 
+// How much of the counter machinery one createTable() attempt asks for. The
+// public `counters` option is a boolean; this is the finer grain the fallback
+// needs, because the two mechanisms have different kernel requirements:
+// stateful counter objects are old, per-element set expressions (NFT_SET_EXPR)
+// are not.
+enum class CounterMode {
+    Full,       // named counter objects, objref in rules, per-element expression
+    NamedOnly,  // as above without the per-element expression
+    None,       // no counter of any kind
+};
+
 class CreateTableOp final : public NlOperation {
 public:
     explicit CreateTableOp(std::shared_ptr<const nft::NftConfig> config);
     NlResult execute(NlSocket& sock) override;
 
 private:
+    // One full attempt. The arguments select the optional features some kernels
+    // reject; execute() retries giving up as little as possible.
+    NlResult create_once(NlSocket& sock, bool use_concat_flag, CounterMode counter_mode);
+
     std::shared_ptr<const nft::NftConfig> cfg_;
 };
 
